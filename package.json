{
  "name": "@qavajs/playwright-wdio-fixtures",
  "version": "2.1.0",
  "description": "collection of webdriverio fixtures for playwright test runner",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "debug": "playwright test --ui --project debug",
    "test": "playwright test --project ci",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "biome lint"
  },
  "author": "Oleksandr Halichenko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qavajs/playwright-wdio-fixtures.git"
  },
  "bugs": {
    "url": "https://github.com/qavajs/playwright-wdio-fixtures/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "webdriverio": "^10.2.0"
  },
  "keywords": [
    "test",
    "testing",
    "webdriverio",
    "playwright"
  ]
}
